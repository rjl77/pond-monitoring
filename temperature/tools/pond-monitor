#!/usr/bin/env bash

set -u

PROGRAM_NAME="pond-monitor"
APP_DIR="/opt/pond-monitor"
REPO_DIR="/opt/pond-monitor-repo"

usage() {
    cat <<EOF
Usage: $PROGRAM_NAME <command>

Commands:
  status    Show Pond Monitor status
  install   Run the Pond Monitor installer
  refresh   Pull the latest version from Git and install it
  logs      Show recent Pond Monitor logs
  version   Show the installed Git version
  help      Show this help
EOF
}

show_version() {
    if [[ ! -d "$REPO_DIR/.git" ]]; then
        echo "Git repository not found: $REPO_DIR" >&2
        return 1
    fi

    local branch
    local commit
    local commit_date
    local dirty="no"

    branch=$(git -C "$REPO_DIR" branch --show-current)
    commit=$(git -C "$REPO_DIR" rev-parse --short HEAD)
    commit_date=$(git -C "$REPO_DIR" log -1 --format='%ci')

    if [[ -n "$(git -C "$REPO_DIR" status --porcelain)" ]]; then
        dirty="yes"
    fi

    echo "Pond Monitor"
    echo "  Branch:      $branch"
    echo "  Commit:      $commit"
    echo "  Commit date: $commit_date"
    echo "  Dirty:       $dirty"
}

show_influx_status() {
    PYTHONPATH="$APP_DIR/src" python3 - <<'PY'
from datetime import datetime, timezone

from pond.config import load_env
from pond.influx import get_temperature_stats_24h

load_env()

def show_sensor(label, sensor):
    stats = get_temperature_stats_24h(sensor)

    timestamp = datetime.fromisoformat(
        stats["current_time"].replace("Z", "+00:00")
    )
    age = int((datetime.now(timezone.utc) - timestamp).total_seconds())

    print(f"  {label}:")
    print(f"    Current:    {stats['current']:.2f} F")
    print(f"    24h low:    {stats['minimum']:.2f} F")
    print(f"    24h high:   {stats['maximum']:.2f} F")
    print(f"    Last write: {age} seconds ago")


show_sensor("Water", "water")
print()
show_sensor("Air", "air")
PY
}

show_status() {
    echo "Pond Monitor"
    echo "============"
    echo

    echo "Services"
    for service in pond-collector.service pond-hubitat.service; do
        enabled=$(systemctl is-enabled "$service" 2>/dev/null || true)
        active=$(systemctl is-active "$service" 2>/dev/null || true)

        printf "  %-24s enabled=%-8s running=%s\n" \
            "$service" "$enabled" "$active"
    done

    echo
    echo "Git"

    if [[ -d "$REPO_DIR/.git" ]]; then
        branch=$(git -C "$REPO_DIR" branch --show-current)
        commit=$(git -C "$REPO_DIR" rev-parse --short HEAD)

        if [[ -n "$(git -C "$REPO_DIR" status --porcelain)" ]]; then
            state="dirty"
        else
            state="clean"
        fi

        echo "  Branch:     $branch"
        echo "  Commit:     $commit"
        echo "  Repository: $state"
    else
        echo "  Repository: not found"
    fi

    echo
    echo "Health"

    if timeout 2 bash -c "echo >/dev/tcp/127.0.0.1/9991" 2>/dev/null; then
        echo "  TCP 9991:   OK"
    else
        echo "  TCP 9991:   FAILED"
    fi

    echo
    echo "InfluxDB"

    if ! show_influx_status; then
        echo "  Status:     FAILED"
    fi
}

run_install() {
    if [[ ! -f "$APP_DIR/install.sh" ]]; then
        echo "Installer not found: $APP_DIR/install.sh" >&2
        return 1
    fi

    if [[ $EUID -ne 0 ]]; then
        echo "Install requires root privileges." >&2
        echo "Run: sudo $PROGRAM_NAME install" >&2
        return 1
    fi

    echo "Running Pond Monitor installer..."
    "$APP_DIR/install.sh"
}

run_refresh() {
    if [[ $EUID -ne 0 ]]; then
        echo "Refresh requires root privileges." >&2
        echo "Run: sudo $PROGRAM_NAME refresh" >&2
        return 1
    fi

    if [[ ! -d "$REPO_DIR/.git" ]]; then
        echo "Git repository not found: $REPO_DIR" >&2
        return 1
    fi

    if [[ -n "$(git -C "$REPO_DIR" status --porcelain)" ]]; then
        echo "Refusing to refresh: Git working tree is not clean." >&2
        git -C "$REPO_DIR" status --short >&2
        return 1
    fi

    echo "Updating Pond Monitor..."
    git -C "$REPO_DIR" pull --ff-only

    echo
    run_install

    echo
    echo "Refresh complete."
    show_version
}

show_logs() {
    local target="all"
    local follow=""

    for arg in "$@"; do
        case "$arg" in
            collector|hubitat)
                target="$arg"
                ;;
            -f|--follow)
                follow="-f"
                ;;
            *)
                echo "Unknown logs option: $arg" >&2
                echo "Usage: $PROGRAM_NAME logs [collector|hubitat] [-f]" >&2
                return 1
                ;;
        esac
    done

    local journal_args=(-n 50)

    if [[ "$follow" == "-f" ]]; then
        journal_args+=(-f)
    fi

    case "$target" in
        all)
            journalctl \
                -u pond-collector.service \
                -u pond-hubitat.service \
                "${journal_args[@]}"
            ;;
        collector)
            journalctl \
                -u pond-collector.service \
                "${journal_args[@]}"
            ;;
        hubitat)
            journalctl \
                -u pond-hubitat.service \
                "${journal_args[@]}"
            ;;
    esac
}

case "${1:-help}" in
    status)
        show_status
        ;;
    install)
        run_install
        ;;
    refresh)
        run_refresh
        ;;
    logs)
        shift
        show_logs "$@"
        ;;
    version)
        show_version
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo >&2
        usage >&2
        exit 2
        ;;
esac