#!/usr/bin/env bash

set -u

ENV_FILE="/opt/pond-monitor/config/pond.env"

if [[ ! -r "$ENV_FILE" ]]; then
    echo "Cannot read configuration: $ENV_FILE" >&2
    exit 1
fi

# Load Pond Monitor configuration.
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

# Determine the active interface and gateway from the default route.
DEFAULT_ROUTE=$(ip route show default | head -n 1)

GATEWAY=$(awk '{for (i=1; i<=NF; i++) if ($i=="via") print $(i+1)}' <<< "$DEFAULT_ROUTE")
INTERFACE=$(awk '{for (i=1; i<=NF; i++) if ($i=="dev") print $(i+1)}' <<< "$DEFAULT_ROUTE")

if [[ -z "$GATEWAY" ]]; then
    echo "Unable to determine default gateway." >&2
    exit 1
fi

if [[ -z "$INTERFACE" ]]; then
    echo "Unable to determine active network interface." >&2
    exit 1
fi

FAILURE_THRESHOLD=2
CHECK_INTERVAL=60

consecutive_failures=0
outage_start=""

log() {
    logger -t pond-network-watchdog "$*"
}

network_reachable() {
    # The default gateway is always our primary LAN test.
    ping -c 1 -W 2 "$GATEWAY" >/dev/null 2>&1 && return 0

    # Test configured application hosts as additional evidence.
    if [[ -n "${INFLUX_HOST:-}" ]]; then
        ping -c 1 -W 2 "$INFLUX_HOST" >/dev/null 2>&1 && return 0
    fi

    if [[ -n "${HUBITAT_HOST:-}" ]]; then
        ping -c 1 -W 2 "$HUBITAT_HOST" >/dev/null 2>&1 && return 0
    fi

    return 1
}

snapshot() {
    log "===== Network diagnostic snapshot ====="

    log "--- NetworkManager ---"
    nmcli -f GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,IP4.GATEWAY \
        device show "$INTERFACE" 2>&1 | logger -t pond-network-watchdog

    if [[ -d "/sys/class/net/$INTERFACE/wireless" ]]; then
        log "--- Wi-Fi link ---"
        iw dev "$INTERFACE" link 2>&1 | logger -t pond-network-watchdog
    else
        log "--- Interface details ---"
        ip -details link show "$INTERFACE" 2>&1 | logger -t pond-network-watchdog
    fi

    log "--- Routes ---"
    ip route 2>&1 | logger -t pond-network-watchdog

    log "--- Neighbours ---"
    ip neigh 2>&1 | logger -t pond-network-watchdog

    log "--- Gateway ping ---"
    ping -c 2 -W 2 "$GATEWAY" 2>&1 | logger -t pond-network-watchdog

    if [[ -n "${INFLUX_HOST:-}" ]]; then
        log "--- InfluxDB host ping ---"
        ping -c 2 -W 2 "$INFLUX_HOST" 2>&1 | logger -t pond-network-watchdog
    fi

    if [[ -n "${HUBITAT_HOST:-}" ]]; then
        log "--- Hubitat host ping ---"
        ping -c 2 -W 2 "$HUBITAT_HOST" 2>&1 | logger -t pond-network-watchdog
    fi

    log "===== End network diagnostic snapshot ====="
}

log "Network watchdog started; interface=$INTERFACE gateway=$GATEWAY"

while true; do
    if network_reachable; then
        if (( consecutive_failures >= FAILURE_THRESHOLD )); then
            outage_end=$(date +%s)
            outage_seconds=$((outage_end - outage_start))

            log "Network connectivity restored after approximately ${outage_seconds} seconds."
        fi

        consecutive_failures=0
        outage_start=""
    else
        ((consecutive_failures++))

        if (( consecutive_failures == 1 )); then
            outage_start=$(date +%s)
            log "LAN connectivity check failed."
        fi

        if (( consecutive_failures == FAILURE_THRESHOLD )); then
            log "LAN connectivity failed ${FAILURE_THRESHOLD} consecutive checks."
            snapshot
        fi
    fi

    sleep "$CHECK_INTERVAL"
done