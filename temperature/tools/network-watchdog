#!/usr/bin/env bash

set -u

ENV_FILE="/opt/pond-collector/config/pond.env"

if [[ ! -r "$ENV_FILE" ]]; then
    echo "Cannot read configuration: $ENV_FILE" >&2
    exit 1
fi

# Load Pond Collector configuration.
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

# Determine the active interface and gateway from the default route.
DEFAULT_ROUTE=$(ip route show default | head -n 1)

GATEWAY=$(awk '{for (i=1; i<=NF; i++) if ($i=="via") print $(i+1)}' <<< "$DEFAULT_ROUTE")
INTERFACE=$(awk '{for (i=1; i<=NF; i++) if ($i=="dev") print $(i+1)}' <<< "$DEFAULT_ROUTE")

if [[ -z "$GATEWAY" ]]; then
    echo "Unable to determine default gateway." >&2
    exit 1
fi

if [[ -z "$INTERFACE" ]]; then
    echo "Unable to determine active network interface." >&2
    exit 1
fi

FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=3
CHECK_INTERVAL=60

consecutive_failures=0
outage_start=""

log() {
    logger -t pond-network-watchdog -- "$*"
}

get_active_connection() {
    nmcli -g GENERAL.CONNECTION device show "$INTERFACE" 2>/dev/null
}

get_recovery_connection() {
    local connection

    connection=$(get_active_connection)

    if [[ -n "$connection" && "$connection" != "--" ]]; then
        printf '%s\n' "$connection"
        return 0
    fi

    nmcli -t -f NAME,TYPE connection show |
        awk -F: '$2=="802-11-wireless" {print $1; exit}'
}

recover_network() {
    local connection

    connection=$(get_recovery_connection)

    if [[ -z "$connection" ]]; then
        log "Network recovery aborted: unable to determine a Wi-Fi connection."
        return 1
    fi

    log "Attempting network recovery; interface=$INTERFACE connection=$connection"

    nmcli device disconnect "$INTERFACE" || true
    sleep 5

    if ! nmcli connection up "$connection"; then
        log "NetworkManager recovery command failed."
        return 1
    fi

    log "NetworkManager connection activated; waiting for network to settle."
    sleep 10

    if validate_dependencies; then
        log "Network recovery successful; required network dependencies are reachable."
        return 0
    fi

    log "Network recovery incomplete; one or more required network dependencies remain unreachable."
    return 1
}

network_reachable() {
    # The default gateway is always our primary LAN test.
    ping -c 1 -W 2 "$GATEWAY" >/dev/null 2>&1 && return 0

    # Test configured application hosts as additional evidence.
    if [[ -n "${INFLUX_HOST:-}" ]]; then
        ping -c 1 -W 2 "$INFLUX_HOST" >/dev/null 2>&1 && return 0
    fi

    if [[ -n "${HUBITAT_HOST:-}" ]]; then
        ping -c 1 -W 2 "$HUBITAT_HOST" >/dev/null 2>&1 && return 0
    fi

    return 1
}

validate_dependencies() {
    local failed=0

    if ping -c 1 -W 2 "$GATEWAY" >/dev/null 2>&1; then
        log "Recovery validation: gateway reachable."
    else
        log "Recovery validation: gateway unreachable."
        failed=1
    fi

    if timeout 3 bash -c "</dev/tcp/${INFLUX_HOST}/${INFLUX_PORT}" 2>/dev/null; then
        log "Recovery validation: InfluxDB TCP/${INFLUX_PORT} reachable."
    else
        log "Recovery validation: InfluxDB TCP/${INFLUX_PORT} unreachable."
        failed=1
    fi

    if [[ "${AIR_SOURCE:-none}" == "hubitat" ]]; then
        if timeout 3 bash -c "</dev/tcp/${HUBITAT_HOST}/80" 2>/dev/null; then
            log "Recovery validation: Hubitat TCP/80 reachable."
        else
            log "Recovery validation: Hubitat TCP/80 unreachable."
            failed=1
        fi
    fi

    return "$failed"
}

snapshot() {
    log "===== Network diagnostic snapshot ====="

    log "--- NetworkManager ---"
    nmcli -f GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,IP4.GATEWAY \
        device show "$INTERFACE" 2>&1 | logger -t pond-network-watchdog

    if [[ -d "/sys/class/net/$INTERFACE/wireless" ]]; then
        log "--- Wi-Fi link ---"
        iw dev "$INTERFACE" link 2>&1 | logger -t pond-network-watchdog
    else
        log "--- Interface details ---"
        ip -details link show "$INTERFACE" 2>&1 | logger -t pond-network-watchdog
    fi

    log "--- Routes ---"
    ip route 2>&1 | logger -t pond-network-watchdog

    log "--- Neighbours ---"
    ip neigh 2>&1 | logger -t pond-network-watchdog

    log "--- Gateway ping ---"
    ping -c 2 -W 2 "$GATEWAY" 2>&1 | logger -t pond-network-watchdog

    if [[ -n "${INFLUX_HOST:-}" ]]; then
        log "--- InfluxDB host ping ---"
        ping -c 2 -W 2 "$INFLUX_HOST" 2>&1 | logger -t pond-network-watchdog
    fi

    if [[ -n "${HUBITAT_HOST:-}" ]]; then
        log "--- Hubitat host ping ---"
        ping -c 2 -W 2 "$HUBITAT_HOST" 2>&1 | logger -t pond-network-watchdog
    fi

    log "===== End network diagnostic snapshot ====="
}

CONNECTION=$(get_active_connection)
log "Network watchdog started; interface=$INTERFACE connection=$CONNECTION gateway=$GATEWAY"

while true; do
    if network_reachable; then
        if (( consecutive_failures >= FAILURE_THRESHOLD )); then
            outage_end=$(date +%s)
            outage_seconds=$((outage_end - outage_start))

            log "Network connectivity restored after approximately ${outage_seconds} seconds."
        fi

        consecutive_failures=0
        outage_start=""
    else
        ((consecutive_failures++))

        if (( consecutive_failures == 1 )); then
            outage_start=$(date +%s)
            log "LAN connectivity check failed."
        fi

        if (( consecutive_failures == FAILURE_THRESHOLD )); then
            log "LAN connectivity failed ${FAILURE_THRESHOLD} consecutive checks."
            snapshot
        fi

        if (( consecutive_failures == RECOVERY_THRESHOLD )); then
            log "LAN connectivity failed ${RECOVERY_THRESHOLD} consecutive checks; starting recovery."
            recover_network
        fi
    fi

    sleep "$CHECK_INTERVAL"
done