# Pond Monitor configuration
#
# Copy this file to pond.env and supply values appropriate
# for the machine. pond.env must never be committed to Git.

# ===== Runtime account =====
# Linux account used to run Pond Monitor services.
SERVICE_USER=pond
SERVICE_GROUP=pond

# ===== Water sensor =====

# DS18B20 1-Wire device ID.
# Discover with:
#   ls /sys/bus/w1/devices/28-*
WATER_SENSOR_ID=28-xxxxxxxxxxxx


# ===== Collection =====

# Sensor collection interval, in seconds.
POLL_INTERVAL=60

# TCP health-check port.
HEALTH_PORT=9991


# ===== InfluxDB =====

INFLUX_HOST=192.168.1.xxx
INFLUX_PORT=8086
INFLUX_USER=writer
INFLUX_PASSWORD=
INFLUX_DATABASE=pond_data


# ===== Air temperature =====

# Supported values initially:
#   hubitat
#   dht
#   none
AIR_SOURCE=hubitat

# Used when AIR_SOURCE=hubitat
HUBITAT_AIR_DEVICE_ID=94


# ===== Hubitat =====

HUBITAT_HOST=192.168.1.xxx
HUBITAT_APP_ID=9
HUBITAT_TOKEN=

# Optional Hubitat publishing service.
HUBITAT_PUBLISH_ENABLED=true

# Hubitat publishing interval, in seconds.
HUBITAT_PUBLISH_INTERVAL=900

HUBITAT_CURRENT_DEVICE_ID=69
HUBITAT_HIGH_DEVICE_ID=70
HUBITAT_LOW_DEVICE_ID=71
HUBITAT_UPDATED_DEVICE_ID=78


# ===== DHT fallback/source =====

# GPIO number used if AIR_SOURCE=dht.
DHT_GPIO=17
